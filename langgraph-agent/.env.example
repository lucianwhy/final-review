# OpenAI-compatible API (leave empty to use mock/demo mode)
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini

# Optional: force remote skill documents ("远端 skill").
# Default is local-first: use repo-root SKILL.md / AGENT.md when present;
# otherwise fall back to the raw GitHub URLs below.
# SKILL_URL=https://raw.githubusercontent.com/lucianwhy/final-review/master/SKILL.md
# AGENT_URL=https://raw.githubusercontent.com/lucianwhy/final-review/master/AGENT.md

# Default output format: text | html
OUTPUT_FORMAT=text
