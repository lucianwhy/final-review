# Compatible chat / embedding provider. Do not commit real keys.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# 用于网页 AI 对话；仅放在本地 .env，绝不写入前端代码。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 网页模型下拉菜单。Key 仅保存在此 .env，不会发送给浏览器。
# 配置后，它会取代上方的兼容 DeepSeek/LLM 默认项；未填写则沿用旧配置。
CHAT_MODELS=[]
# XPeach models shown in the chat-model selector.
XPEACH_API_KEY=
XPEACH_BASE_URL=https://fast.xpeach.codes/v1
XPEACH_CHAT_MODEL=
XPEACH_CHAT_LABEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Local PostgreSQL + pgvector. docker compose applies the migration on first start.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://final_review:change-me@127.0.0.1:5432/final_review
AUTH_MODE=database
AUTH_COOKIE_NAME=final_review_access
# Local HTTP development only. Set true behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_DAYS=30

# Optional bearer token; default bind is localhost. Set token before sharing.
API_TOKEN=
MAX_UPLOAD_MB=10
# Optional absolute executable paths; otherwise use PATH / standard install locations.
POPPLER_EXECUTABLE=
LIBREOFFICE_EXECUTABLE=
TESSERACT_EXECUTABLE=
TESSDATA_PREFIX=
# Visual slide reading: choose a configured CHAT_MODELS provider id and vision model.
MATERIAL_VISION_ENABLED=true
MATERIAL_VISION_MODEL_ID=default
MATERIAL_VISION_MODEL=qwen3-vl-plus
MATERIAL_VISION_TIMEOUT=90
MATERIAL_VISION_REPAIRS=1
MATERIAL_VISION_CONCURRENCY=4
TOP_K=5
RETRIEVAL_CANDIDATES=20
MIN_SIMILARITY=0.25
MAX_REPAIRS=1
MODEL_TIMEOUT=60
# 笔记 worker 的单次模型请求预算，与网页聊天分开配置。
NOTE_MODEL_TIMEOUT=120
NOTE_MODEL_MAX_RETRIES=1
QUIZ_MODEL_TIMEOUT=120
QUIZ_MAX_REPAIRS=2
# Export files are private; never mount this directory as a static URL.
EXPORTS_DIR=exports
# Empty uses bundled Pandoc and Playwright-managed Chromium.
EXPORT_PANDOC_EXECUTABLE=
EXPORT_CHROMIUM_EXECUTABLE=

# Quiz generation: bounded batches and explicit output token budget
QUIZ_MAX_OUTPUT_TOKENS=16384
QUIZ_CHOICE_BATCH_SIZE=5
QUIZ_WRITTEN_BATCH_SIZE=2
